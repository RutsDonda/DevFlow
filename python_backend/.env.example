# ═══════════════════════════════════════════════════════════════════════════════
# AI DevFlow – backend environment. Copy to `.env` and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=5000
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas (recommended – enables Atlas Vector Search) or a local mongod.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-devflow?retryWrites=true&w=majority
# Optional – defaults to the database name in the URI
# MONGODB_DB=ai-devflow

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Firebase console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional service account (Project settings → Service accounts → Generate new private key).
# Not required to verify ID tokens; use ONE of these if you want admin features.
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ── LLM ───────────────────────────────────────────────────────────────────────
# google → Gemini (https://aistudio.google.com/apikey)   openai → OpenAI
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
# Optional cheaper model just for supervisor routing
SUPERVISOR_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-...
# For OpenAI use e.g.: LLM_PROVIDER=openai  LLM_MODEL=gpt-4o-mini  SUPERVISOR_MODEL=gpt-4o-mini

# Client-side throttle per model (0 = off). The Gemini free tier allows ~5 req/min per model.
LLM_REQUESTS_PER_MINUTE=10
# Models to switch to when one is out of quota / overloaded (empty = provider default, "none" = off)
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2

# ── Embeddings / RAG ──────────────────────────────────────────────────────────
# Defaults to the LLM provider. google → gemini-embedding-001, openai → text-embedding-3-small
# EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
# Must match the Atlas vector index. If you change it, drop the index
# "document_chunks_vector_index" and re-upload documents.
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
MAX_UPLOAD_MB=20
